# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Node.js
node_modules/
npm-debug.log*
dist/
dist-ssr/
.vite/

# Tauri
src-tauri/target/
src-tauri/WixTools/

# SQLite database files (user data — not committed)
*.db
*.db-shm
*.db-wal

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/settings.json
.idea/
*.swp
*.swo

# Build artifacts
*.log
*.tgz
*.tsbuildinfo

# Test output (actual reports committed if needed)
playwright-report/
test-results/

# Lockfiles from other package managers (we use npm)
pnpm-lock.yaml
yarn.lock
